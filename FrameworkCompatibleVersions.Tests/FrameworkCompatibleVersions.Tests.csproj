<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />

        <!-- Required when dotnet test uses Microsoft Testing Platform -->
        <PackageReference Include="xunit.v3.mtp-v2" />

        <!-- Microsoft Testing Platform code coverage extension (replaces coverlet/VSTest collector) -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\FrameworkCompatibleVersions\Sdk\Sdk.props"
              Link="Sdk\Sdk.props"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\FrameworkCompatibleVersions\Sdk\Sdk.targets"
              Link="Sdk\Sdk.targets"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Update="xunit.runner.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
